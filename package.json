{
  "author": {
    "name": "Santiago Gomez de Oliveira",
    "email": "santiagogdo.hybrid891@passinbox.com"
  },
  "name": "nodeflow",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist",
    "docs"
  ],
  "main": "./dist/nodeflow.umd.cjs",
  "module": "./dist/nodeflow.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/nodeflow.d.ts",
        "default": "./dist/nodeflow.js"
      },
      "require": {
        "types": "./dist/nodeflow.d.cts",
        "default": "./dist/nodeflow.umd.cjs"
      }
    },
    "./style.css": "./dist/nodeflow.css"
  },
  "types": "dist/nodeflow.d.ts",
  "scripts": {
    "example": "node ./examples/run-example.js",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/build-declarations.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5",
    "vitest-canvas-mock": "^0.3.3"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
